# Backend configuration. All values are optional for local development.
# Copy to `.env` (or set them in your host's dashboard).

# SQLAlchemy database URL. SQLite uses four slashes for an absolute path.
# DATABASE_URL=sqlite:///./airbnb.db

# Comma-separated list of browser origins allowed to call the API.
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Directory for uploaded images.
# UPLOAD_DIR=./uploads
