# Base URL for the FastAPI backend.
#
# Local development (frontend + backend as separate servers):
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# Vercel Services (frontend + backend in one project, one domain):
#   NEXT_PUBLIC_API_URL=same-origin
#   -> the API is a sibling service mounted at /api on the same origin.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
